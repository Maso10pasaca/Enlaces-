# Required: generate a random secret with at least 32 characters.
ENLACES_API_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
WHISPER_MODEL=base
MAX_FILE_BYTES=209715200
MAX_CONCURRENT_JOBS=1
PORT=8000
# Optional comma-separated host allowlist; Render sets RENDER_EXTERNAL_HOSTNAME automatically.
# MCP_ALLOWED_HOSTS=example.onrender.com,example.onrender.com:*
